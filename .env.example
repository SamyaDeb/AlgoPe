# AlgoPe Environment Variables
# Copy to .env and fill in your values

# ============================================================================
# PROVIDER CONFIGURATION (algope CLI)
# ============================================================================

# Your Algorand wallet address (58-char base32)
# This is where you'll receive payments
ALGOPE_WALLET_ADDRESS=YOUR_ALGORAND_ADDRESS

# Your 25-word Algorand mnemonic (keep this secret!)
# Used to sign registry transactions
ALGOPE_MNEMONIC="word1 word2 word3 ... word25"

# Backend API URL to proxy
ALGOPE_TARGET=http://localhost:3000

# Price per request (in ALGO or USDC)
ALGOPE_PRICE=0.01

# Payment token: ALGO or USDC
ALGOPE_TOKEN=ALGO

# Service name for the registry
ALGOPE_SERVICE_NAME=My AI Service

# Service description
ALGOPE_SERVICE_DESCRIPTION=An AI-powered service

# Tags (comma-separated)
ALGOPE_TAGS=ai,nlp,research

# Proxy port
ALGOPE_PORT=4402

# Network: testnet or mainnet
ALGOPE_NETWORK=testnet

# Log level: verbose, normal, quiet
ALGOPE_LOG_LEVEL=normal

# Bearer token for a gated x402 facilitator (optional — the public
# GoPlausible facilitator needs none). Also settable with --facilitator-key.
ALGOPE_FACILITATOR_API_KEY=

# Facilitator selection is stored in ~/.algope/config.json as `facilitatorMode`
# and can be overridden per-run:
#   algope start --facilitator-mode auto         # GoPlausible, fall back locally (default)
#   algope start --facilitator-mode goplausible  # require the hosted facilitator
#   algope start --facilitator-mode self         # relay client-signed txns yourself
#   algope start --facilitator "<25 words>"      # in-process local facilitator
#   algope start --facilitator-url https://...   # self-hosted facilitator

# On-chain registry App ID. Every package checks this first, then its local
# config file, then a compiled-in default (currently 769455464 on testnet).
ALGOPE_REGISTRY_APP_ID=769455464

# Admin wallet that receives the 1 ALGO registration fee. Must match the
# address hardcoded in the deployed contract, or register() will fail.
ALGOPE_ADMIN_ADDRESS=CIQZP6I73Q5527QWZHZLZBIDSOHVV5LMP5IEQNQYVRXYOZTQSYB7X57PBE

# ============================================================================
# CONTRACT DEPLOYMENT (contracts/scripts/deploy.ts)
# ============================================================================

# 25-word mnemonic of the deploying account. Needs >= 2 ALGO. Keep secret.
DEPLOYER_MNEMONIC="word1 word2 word3 ... word25"

# testnet (default) or mainnet
NETWORK=testnet

# Must be true to redeploy. The contract has no updateApplication handler, so
# the default idempotent path (onUpdate: "update") cannot succeed against it.
FORCE_NEW=true

# ============================================================================
# AGENT CONFIGURATION (algope-agent SDK)
# ============================================================================

# LLM Provider: openai or anthropic
AGENT_LLM_PROVIDER=openai

# LLM Model
AGENT_LLM_MODEL=gpt-4o

# API Key for the LLM provider
AGENT_LLM_API_KEY=your-api-key

# Preferred payment token: ALGO or USDC
AGENT_PREFERRED_TOKEN=ALGO

# Registry path
AGENT_REGISTRY_PATH=~/.algope/registry.json

# ============================================================================
# TESTNET RESOURCES
# ============================================================================

# Get testnet ALGO:
#   https://bank.testnet.algorand.network/

# Get testnet USDC:
#   https://dispenser.testnet.aws.algodev.network/

# Algorand Testnet Explorer:
#   https://testnet.explorer.perawallet.app/

# x402 Facilitator (GoPlausible):
#   https://facilitator.goplausible.xyz

{
  "name": "algope-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoPe \u2014 AI Agent Marketplace on Algorand with x402 micropayments",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:cli": "npm run build --workspace=@algope/cli",
    "build:agent": "npm run build --workspace=@algope/agent",
    "build:wallet": "npm run build --workspace=algope-wallet-mcp",
    "build:mcpb": "npm run build:mcpb --workspace=algope-wallet-mcp",
    "test:wallet": "npm run test --workspace=algope-wallet-mcp",
    "dev": "npm run dev --workspace=@algope/cli",
    "dev:agent": "npm run dev --workspace=@algope/agent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "publish:cli": "npm publish --workspace=@algope/cli --access public",
    "publish:agent": "npm publish --workspace=@algope/agent --access public",
    "publish:all": "npm run publish:cli && npm run publish:agent",
    "test": "npm run test --workspaces --if-present",
    "test:cli": "npm run test --workspace=@algope/cli",
    "test:live": "npm run test:live --workspace=@algope/cli",
    "loadtest": "node packages/algope/scripts/loadtest.mjs",
    "test:paid": "node packages/algope/scripts/paid-e2e.mjs"
  },
  "keywords": [
    "x402",
    "algorand",
    "ai-agents",
    "marketplace",
    "micropayments",
    "pay-per-request",
    "http-402",
    "blockchain",
    "usdc",
    "api-monetization"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}